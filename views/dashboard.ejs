<%- include("layouts/header") %>

<div class="container-fluid">

    <h2 class="mb-4">
        Dashboard
    </h2>

<div class="row g-4">

    <div class="col-md-3">
        <div class="card border-0 shadow-lg rounded-4 bg-primary text-white">
            <div class="card-body d-flex justify-content-between align-items-center">
                <div>
                    <h6>Total Customers</h6>
                    <h2><%= totalCustomers || 0 %></h2>
                </div>
                <i class="bi bi-people-fill display-4"></i>
            </div>
        </div>
    </div>

    <div class="col-md-3">
        <div class="card border-0 shadow-lg rounded-4 bg-success text-white">
            <div class="card-body d-flex justify-content-between align-items-center">
                <div>
                    <h6>Total Products</h6>
                    <h2><%= totalProducts || 0 %></h2>
                </div>
                <i class="bi bi-box-seam display-4"></i>
            </div>
        </div>
    </div>

    <div class="col-md-3">
        <div class="card border-0 shadow-lg rounded-4 bg-warning">
            <div class="card-body d-flex justify-content-between align-items-center">
                <div>
                    <h6>Total Invoices</h6>
                    <h2><%= totalInvoices || 0 %></h2>
                </div>
                <i class="bi bi-receipt-cutoff display-4"></i>
            </div>
        </div>
    </div>

    <div class="col-md-3">
        <div class="card border-0 shadow-lg rounded-4 bg-danger text-white">
            <div class="card-body d-flex justify-content-between align-items-center">
                <div>
                    <h6>Total Revenue</h6>
                    <h2>₹ <%= totalRevenue || 0 %></h2>
                </div>
                <i class="bi bi-currency-rupee display-4"></i>
            </div>
        </div>
    </div>

</div>

<div class="card shadow border-0 mt-4">

    <div class="card-header bg-dark text-white">
        <h5 class="mb-0">Recent Invoices</h5>
    </div>

    <div class="card-body">

        <table class="table table-hover">

            <thead>

                <tr>
                    <th>Invoice No.</th>
                    <th>Customer</th>
                    <th>Date</th>
                    <th>Amount</th>
                </tr>

            </thead>

            <tbody>

                <% if (recentInvoices && recentInvoices.length > 0) { %>

                    <% recentInvoices.forEach(invoice => { %>

                        <tr>

                            <td><%= invoice.invoice_number %></td>

                            <td><%= invoice.customer_name %></td>

                            <td><%= invoice.invoice_date %></td>

                            <td>₹ <%= invoice.grand_total %></td>

                        </tr>

                    <% }) %>

                <% } else { %>

                    <tr>
                        <td colspan="4" class="text-center">
                            No Invoices Found
                        </td>
                    </tr>

                <% } %>

            </tbody>

        </table>

    </div>

</div>

<%- include("layouts/footer") %>