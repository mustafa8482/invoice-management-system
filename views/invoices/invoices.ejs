<%- include("../layouts/header") %>

<div class="container-fluid">

    <div class="d-flex justify-content-between align-items-center mb-4">

        <div>
            <h2 class="fw-bold">Invoices</h2>
            <p class="text-muted mb-0">
                Manage all invoices
            </p>
        </div>

        <a href="/invoices/add" class="btn btn-primary">
            <i class="bi bi-plus-circle"></i>
            Create Invoice
        </a>

    </div>

    <div class="card shadow border-0 rounded-4">

        <div class="card-body">

            <div class="row mb-3">

                <div class="col-md-4 ms-auto">

                    <input
                        type="text"
                        id="searchInvoice"
                        class="form-control"
                        placeholder="🔍 Search Invoice">

                </div>

            </div>

            <div class="table-responsive">

                <table class="table table-hover align-middle" id="invoiceTable">

                    <thead class="table-dark">

                        <tr>
                            <th>ID</th>
                            <th>Invoice No.</th>
                            <th>Customer</th>
                            <th>Date</th>
                            <th>Total</th>
                            <th>GST</th>
                            <th>Grand Total</th>
                            <th width="260">Action</th>
                        </tr>

                    </thead>

                    <tbody>

                        <% invoices.forEach(invoice => { %>

                        <tr>

                            <td><%= invoice.id %></td>

                            <td>
                                <strong><%= invoice.invoice_number %></strong>
                            </td>

                            <td><%= invoice.customer_name %></td>

                            <td>
                                <%= new Date(invoice.invoice_date).toLocaleDateString("en-IN") %>
                            </td>

                            <td>₹ <%= Number(invoice.total).toFixed(2) %></td>

                            <td>
                                <span class="badge bg-success">
                                    ₹ <%= Number(invoice.gst).toFixed(2) %>
                                </span>
                            </td>

                            <td>
                                <strong class="text-primary">
                                    ₹ <%= Number(invoice.grand_total).toFixed(2) %>
                                </strong>
                            </td>

                            <td>

                                <a
                                    href="/invoices/<%= invoice.id %>"
                                    class="btn btn-info btn-sm text-white"
                                    title="View">

                                    <i class="bi bi-eye"></i>

                                </a>

                                <a
                                    href="/invoices/<%= invoice.id %>/edit"
                                    class="btn btn-warning btn-sm"
                                    title="Edit">

                                    <i class="bi bi-pencil-square"></i>

                                </a>

                                <a
                                    href="/invoices/<%= invoice.id %>/pdf"
                                    class="btn btn-success btn-sm"
                                    title="Download PDF">

                                    <i class="bi bi-file-earmark-pdf"></i>

                                </a>

                                <form
                                    action="/invoices/<%= invoice.id %>?_method=DELETE"
                                    method="POST"
                                    style="display:inline;">

                                    <button
                                        class="btn btn-danger btn-sm"
                                        onclick="return confirm('Delete this invoice?')">

                                        <i class="bi bi-trash"></i>

                                    </button>

                                </form>

                            </td>

                        </tr>

                        <% }) %>

                    </tbody>

                </table>

            </div>

        </div>

    </div>

</div>

<script>

const search=document.getElementById("searchInvoice");

search.addEventListener("keyup",()=>{

const value=search.value.toLowerCase();

const rows=document.querySelectorAll("#invoiceTable tbody tr");

rows.forEach(row=>{

row.style.display=row.innerText.toLowerCase().includes(value)
?"":"none";

});

});

</script>

<%- include("../layouts/footer") %>