<%- include("../layouts/header") %>

<div class="card shadow">

    <div class="card-header bg-primary text-white">
        <h4 class="mb-0">
    <%= typeof isEdit !== "undefined" && isEdit ? "Edit Invoice" : "Create Invoice" %>
</h4>
    <div class="container mt-4 mb-5">

    <div class="card-body">

        <form action="<%= (typeof isEdit !== 'undefined' && isEdit) ? '/invoices/' + invoice.id + '?_method=PUT' : '/invoices/add' %>" method="POST">

           <div class="card shadow-sm border-0 mb-4">

    <div class="card-header bg-primary text-white">
        <h5 class="mb-0">
            <i class="bi bi-receipt"></i>
            Invoice Information
        </h5>
    </div>

    <div class="card-body">

        <div class="row">

            <div class="col-md-4 mb-3">

                <label class="form-label fw-semibold">
                    Invoice Number
                </label>

                <div class="input-group">

                    <span class="input-group-text">
                        <i class="bi bi-hash"></i>
                    </span>

                    <input
                        type="text"
                        class="form-control"
                        name="invoice_number"
                        value="<%= (typeof isEdit !== 'undefined' && isEdit) ? invoice.invoice_number : '' %>"
                        placeholder="INV-001"
                        required>

                </div>

            </div>

            <div class="col-md-4 mb-3">

                <label class="form-label fw-semibold">
                    Invoice Date
                </label>

                <div class="input-group">

                    <span class="input-group-text">
                        <i class="bi bi-calendar-event"></i>
                    </span>

                    <input
                        type="date"
                        class="form-control"
                        name="invoice_date"
                        value="<%= isEdit ? invoice.invoice_date : '' %>"
                        required>

                </div>

            </div>

            <div class="col-md-4 mb-3">

                <label class="form-label fw-semibold">
                    Customer
                </label>

                <div class="input-group">

                    <span class="input-group-text">
                        <i class="bi bi-person-fill"></i>
                    </span>

                    <select
                        class="form-select"
                        name="customer_id"
                        required>

                        <option value="">Select Customer</option>

                        <% customers.forEach(customer => { %>

                        <option
                            value="<%= customer.id %>"
                            <%= isEdit && invoice.customer_id == customer.id ? "selected" : "" %>>

                            <%= customer.customer_name %>

                        </option>

                        <% }) %>

                    </select>

                </div>

            </div>

        </div>

    </div>

</div>

            <hr>

          <div class="card shadow-sm border-0 mb-4">

    <div class="card-header bg-success text-white">
        <h5 class="mb-0">
            <i class="bi bi-box-seam"></i>
            Add Product
        </h5>
    </div>

    <div class="card-body">

        <div class="row g-3 align-items-end">

            <div class="col-md-5">

                <label class="form-label fw-semibold">Product</label>

                <select
                    id="product"
                    name="product_id"
                    class="form-select">

                    <option value="">Select Product</option>

                    <% products.forEach(product => { %>

                    <option value="<%= product.id %>">
                        <%= product.product_name %>
                    </option>

                    <% }) %>

                </select>

            </div>

            <div class="col-md-2">

                <label class="form-label fw-semibold">Qty</label>

                <input
                    type="number"
                    id="quantity"
                    name="quantity"
                    class="form-control"
                    value="1"
                    min="1">

            </div>

            <div class="col-md-2">

                <label class="form-label fw-semibold">Price</label>

                <div class="input-group">
                    <span class="input-group-text">₹</span>

                    <input
                        type="text"
                        id="price"
                        class="form-control"
                        value="0"
                        readonly>
                </div>

            </div>

            <div class="col-md-2">

                <label class="form-label fw-semibold">Total</label>

                <div class="input-group">
                    <span class="input-group-text">₹</span>

                    <input
                        type="text"
                        id="total"
                        class="form-control"
                        value="0"
                        readonly>
                </div>

            </div>

            <div class="col-md-1 d-grid">

                <button
                    type="button"
                    id="addItemBtn"
                    class="btn btn-success">

                    <i class="bi bi-plus-lg"></i>

                </button>

            </div>

        </div>

    </div>

</div>

            <hr>

<div class="card shadow-sm border-0 mb-4">

    <div class="card-header bg-dark text-white">

        <h5 class="mb-0">
            <i class="bi bi-table"></i>
            Invoice Items
        </h5>

    </div>

    <div class="card-body p-0">

        <div class="table-responsive">

            <table class="table table-hover align-middle mb-0">

                <thead class="table-dark">

                    <tr>
                        <th>Product</th>
                        <th>Price</th>
                        <th>GST %</th>
                        <th>Quantity</th>
                        <th>Total</th>
                        <th width="80">Action</th>
                    </tr>

                </thead>

                <tbody id="invoiceItems">

                    <tr>

                        <td colspan="6" class="text-center text-muted py-4">

                            <i class="bi bi-cart-x fs-3 d-block mb-2"></i>

                            No Products Added

                        </td>

                    </tr>

                </tbody>

            </table>

        </div>

    </div>

</div>
           <div class="row justify-content-end">

    <div class="col-lg-5">

        <div class="card shadow border-0">

            <div class="card-header bg-primary text-white">
                <h5 class="mb-0">
                    <i class="bi bi-calculator"></i>
                    Invoice Summary
                </h5>
            </div>

            <div class="card-body">

                <table class="table table-borderless mb-0">

                    <tr>
                        <th>Subtotal</th>
                        <td class="text-end fw-bold" id="subtotal">₹ 0.00</td>
                    </tr>

                    <tr>
                        <th>Discount Type</th>
                        <td>
                            <select id="discountType" class="form-select">
                                <option value="amount">₹ Amount</option>
                                <option value="percent">Percentage (%)</option>
                            </select>
                        </td>
                    </tr>

                    <tr>
                        <th>Discount</th>
                        <td>
                            <input
                                type="number"
                                id="discount"
                                class="form-control"
                                value="0"
                                min="0">
                        </td>
                    </tr>

                    <tr>
                        <th>CGST</th>
                        <td class="text-end text-success fw-bold" id="cgst">₹ 0.00</td>
                    </tr>

                    <tr>
                        <th>SGST</th>
                        <td class="text-end text-success fw-bold" id="sgst">₹ 0.00</td>
                    </tr>

                    <tr class="table-primary">

                        <th class="fs-5">
                            Grand Total
                        </th>

                        <th
                            class="text-end fs-4 text-primary"
                            id="grandTotal">

                            ₹ 0.00

                        </th>

                    </tr>

                </table>

            </div>

        </div>

    </div>

</div>

             <input
             type="hidden"
             name="invoice_items"
             id="invoice_items">


             <input type="hidden" id="subtotalInput" name="subtotal">
             <input type="hidden" id="gstInput" name="gst">
             <input type="hidden" id="grandTotalInput" name="grand_total">
             <input type="hidden" id="discountInput" name="discount">

<div class="d-flex justify-content-between mt-4">

    <a href="/invoices" class="btn btn-secondary btn-lg">
        <i class="bi bi-arrow-left"></i>
        Back
    </a>

    <button
        type="submit"
        class="btn btn-success btn-lg px-5">

        <i class="bi bi-check-circle-fill"></i>

        <%= isEdit ? "Update Invoice" : "Save Invoice" %>

    </button>

</div>

        </form>

    </div>

</div>

<script>

const isEdit = <%= isEdit ? true : false %>;
const product = document.getElementById("product");
const quantity = document.getElementById("quantity");
const price = document.getElementById("price");
const total = document.getElementById("total");

const addItemBtn = document.getElementById("addItemBtn");
const invoiceItems = document.getElementById("invoiceItems");

const subtotal = document.getElementById("subtotal");
const cgst = document.getElementById("cgst");
const sgst = document.getElementById("sgst");
const grandTotal = document.getElementById("grandTotal");
const discount = document.getElementById("discount");
const discountType = document.getElementById("discountType");
const discountInput = document.getElementById("discountInput");

const invoiceItemsInput = document.getElementById("invoice_items");
const subtotalInput = document.getElementById("subtotalInput");
const gstInput = document.getElementById("gstInput");
const grandTotalInput = document.getElementById("grandTotalInput");

let items = [];

const existingItems = <%- JSON.stringify(items || []) %>;

if (isEdit) {

    items = existingItems.map(item => ({
        product_id: item.product_id,
        quantity: Number(item.quantity),
        price: Number(item.price),
        total: Number(item.total).toFixed(2)
    }));

}

// Product Change
product.addEventListener("change", async () => {

    if (!product.value) {
        price.value = 0;
        total.value = 0;
        return;
    }

    const res = await fetch("/products/" + product.value);
    const data = await res.json();

    price.value = data.price;
    total.value = (
    Number(data.price) * Number(quantity.value)
).toFixed(2);

});

// Quantity Change
quantity.addEventListener("input", () => {
    total.value = (
    Number(price.value) * Number(quantity.value)
).toFixed(2);
});

// Render Table
function renderTable() {

    if (items.length === 0) {

        invoiceItems.innerHTML = `
            <tr>
                <td colspan="6" class="text-center">
                    No Products Added
                </td>
            </tr>
        `;

        calculateTotals();
        return;
    }

    invoiceItems.innerHTML = "";

    items.forEach((item, index) => {

        const productName =
            product.querySelector(`option[value="${item.product_id}"]`).text;

        invoiceItems.insertAdjacentHTML("beforeend", `
            <tr>
                <td>${productName}</td>
                <td>${item.price}</td>
                <td>18%</td>
               <td>
                   <button
                       type="button"
                       class="btn btn-danger btn-sm minusBtn"
                       data-index="${index}">
                       -
                   </button>

                    <span class="mx-2 fw-bold">
                        ${item.quantity}
                    </span>

                    <button
                        type="button"
                        class="btn btn-success btn-sm plusBtn"
                        data-index="${index}">
                        +
                    </button>
                </td>

                <td>${item.total}</td>
            </tr>
        `);

    });

    invoiceItemsInput.value = JSON.stringify(items);

    calculateTotals();

}

// Calculate Totals
function calculateTotals() {

    let sub = 0;

    items.forEach(item => {
        sub += Number(item.total);
    });

    // Discount Calculate
    let discountValue = 0;

    if (discountType.value === "amount") {

        discountValue = Number(discount.value);

    } else {

        discountValue = (sub * Number(discount.value)) / 100;

    }

    // Discount subtotal se zyada na ho
    if (discountValue > sub) {
        discountValue = sub;
    }

    const taxableAmount = sub - discountValue;

    const cgstValue = taxableAmount * 0.09;
    const sgstValue = taxableAmount * 0.09;

    const grand = taxableAmount + cgstValue + sgstValue;

    subtotal.innerText = sub.toFixed(2);
    cgst.innerText = cgstValue.toFixed(2);
    sgst.innerText = sgstValue.toFixed(2);
    grandTotal.innerText = grand.toFixed(2);

    subtotalInput.value = sub.toFixed(2);
    discountInput.value = discountValue.toFixed(2);
    gstInput.value = (cgstValue + sgstValue).toFixed(2);
    grandTotalInput.value = grand.toFixed(2);

    invoiceItemsInput.value = JSON.stringify(items);

}

// Add Item
addItemBtn.addEventListener("click", () => {

    if (product.value === "") {
        alert("Please select a product");
        return;
    }

    const existing = items.find(
        item => item.product_id == product.value
    );

    if (existing) {

        existing.quantity =
            Number(existing.quantity) + Number(quantity.value);

        existing.total =
            (Number(existing.quantity) * Number(existing.price)).toFixed(2);

    } else {

        items.push({
            product_id: product.value,
            quantity: Number(quantity.value),
            price: Number(price.value),
            total: Number(total.value).toFixed(2)
        });

    }

    renderTable();

    // Reset
    product.value = "";
    quantity.value = 1;
    price.value = 0;
    total.value = 0;

});

// Delete Item
invoiceItems.addEventListener("click", function (e) {

    const index = e.target.dataset.index;

    if (index === undefined) return;

    // PLUS BUTTON
    if (e.target.classList.contains("plusBtn")) {

        items[index].quantity++;

       items[index].total =
    (items[index].quantity * items[index].price).toFixed(2);

        renderTable();

    }

    // MINUS BUTTON
    if (e.target.classList.contains("minusBtn")) {

        if (items[index].quantity > 1) {

            items[index].quantity--;

            items[index].total =
    (items[index].quantity * items[index].price).toFixed(2);

        } else {

            items.splice(index, 1);

        }

        renderTable();
    }

});

discount.addEventListener("input", calculateTotals);
discountType.addEventListener("change", calculateTotals);

renderTable();


</script>

<%- include("../layouts/footer") %>