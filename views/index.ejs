<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Invoice Management System</title>

    <style>
        *{
            margin:0;
            padding:0;
            box-sizing:border-box;
            font-family:Arial,sans-serif;
        }

        body{
            background:#f4f4f4;
        }

        .container{
            width:90%;
            max-width:1000px;
            margin:50px auto;
            text-align:center;
        }

        h1{
            color:#333;
            margin-bottom:20px;
        }

        p{
            color:#666;
            margin-bottom:40px;
        }

        .btn{
            display:inline-block;
            padding:15px 30px;
            background:#007bff;
            color:white;
            text-decoration:none;
            border-radius:8px;
            font-size:18px;
        }

        .btn:hover{
            background:#0056b3;
        }
    </style>
</head>

<body>

<div class="container">

<h1>Invoice Management System</h1>

<p>Build invoices, manage customers, download PDFs and much more.</p>

<a href="/invoice" class="btn">
Create Invoice
</a>

</div>

</body>
</html>